# Seed a fresh instance: the published port, database passwords and the
# eLabFTW SECRET_KEY (a Defuse\Crypto key; eLabFTW encrypts stored secrets such
# as the LDAP bind password with it, so it must never change afterwards).
# The key is generated with the application's own library from the pinned
# image, which the node has already pulled at this point.

import os

import agent

tcp_ports = [p.strip() for p in os.environ.get("TCP_PORTS", "").split(",") if p.strip()]
agent.set_env("WEB_PORT", tcp_ports[0] if tcp_ports else "8080")
agent.set_env("TZ", "UTC")
agent.set_env("MAX_UPLOAD_MB", "100")
agent.set_env("LDAP_ENABLED", "False")
