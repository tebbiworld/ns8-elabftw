# Generate the secrets into state/passwords.env (mode 0600): they must not be
# stored in state/environment, which NS8 mirrors to Redis in plain text.
# SECRET_KEY is a Defuse\Crypto key; eLabFTW encrypts stored secrets with it, so
# it is generated once with the application image and never changed.

import os
import secrets
import subprocess

import modsecrets

current = modsecrets.read()
new = {}
if not current.get("MYSQL_ROOT_PASSWORD"):
    new["MYSQL_ROOT_PASSWORD"] = secrets.token_hex(16)
if not current.get("MYSQL_PASSWORD"):
    new["MYSQL_PASSWORD"] = secrets.token_hex(16)
if not current.get("SECRET_KEY"):
    new["SECRET_KEY"] = subprocess.run(
        ["podman", "run", "--rm", "--network=none", "--entrypoint", "php", os.environ["ELABIMG_IMAGE"], "-r",
         'require "/elabftw/vendor/autoload.php"; echo \\Defuse\\Crypto\\Key::createNewRandomKey()->saveToAsciiSafeString();'],
        capture_output=True, text=True, check=True,
    ).stdout.strip()
modsecrets.write(new)
