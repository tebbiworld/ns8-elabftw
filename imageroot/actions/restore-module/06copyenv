# Carry the settings and secrets of the backed-up instance over to the new
# one. SECRET_KEY must be the original: eLabFTW encrypted stored passwords
# with it; the database passwords must match the dump's users.

import json
import sys

import agent
import modsecrets

request = json.load(sys.stdin)
if "environment" in request:
    # restore-module: the environment of the backup comes with the request
    env = request["environment"]
else:
    # clone-module (this file is linked there as 20copyenv): the core imports only
    # the variables the new instance does not have yet, so everything preset by
    # create-module would keep its default. The core leaves the source instance's
    # environment in state/environment.clone-module until its last step.
    env = agent.read_envfile("environment.clone-module")
keep = ["TRAEFIK_HOST", "TRAEFIK_HTTP2HTTPS", "TRAEFIK_LETS_ENCRYPT", "TZ", "MAX_UPLOAD_MB",
        "LDAP_ENABLED", "LDAP_URL", "LDAP_HOST", "LDAP_PORT", "LDAP_SCHEME", "LDAP_BASE_DN", "LDAP_BIND_DN",
        "LDAP_USER_ATTRIBUTE", "LDAP_MAIL_ATTRIBUTE", "LDAP_FIRSTNAME_ATTRIBUTE", "LDAP_LASTNAME_ATTRIBUTE", "LDAP_CONTAINER_HOST", "LDAP_VALIDATE_CERT"]
agent.mset_env({k: env[k] for k in keep if k in env})

# Secrets come back with the restored state/passwords.env. A backup taken with
# module version 1.0.0 still carries them in the environment: move them to the
# file. SECRET_KEY must be the original one, the database content is encrypted
# with it.
legacy = {k: env[k] for k in ("SECRET_KEY", "MYSQL_ROOT_PASSWORD", "MYSQL_PASSWORD", "LDAP_BIND_PASSWORD") if env.get(k)}
if legacy:
    modsecrets.write(legacy)
    print("restored legacy secrets from the backup environment into passwords.env", file=sys.stderr)
