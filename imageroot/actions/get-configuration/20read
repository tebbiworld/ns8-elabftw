import json
import os
import sys
import urllib.request

import agent

host = os.getenv("TRAEFIK_HOST", "")
up = False
try:
    with urllib.request.urlopen(f"http://127.0.0.1:{os.environ['WEB_PORT']}/healthcheck", timeout=3) as r:
        up = 200 <= r.status < 300
except Exception:
    pass
config = {
    "host": host,
    "http2https": os.getenv("TRAEFIK_HTTP2HTTPS") == "True",
    "lets_encrypt": agent.get_route(os.environ["MODULE_ID"]).get("lets_encrypt", False),
    "timezone": os.getenv("TZ", "UTC"),
    "max_upload_mb": int(os.getenv("MAX_UPLOAD_MB", "100")),
    "ldap_enabled": os.getenv("LDAP_ENABLED") == "True",
    "ldap_url": os.getenv("LDAP_URL", ""),
    "ldap_base_dn": os.getenv("LDAP_BASE_DN", ""),
    "ldap_bind_dn": os.getenv("LDAP_BIND_DN", ""),
    "ldap_bind_password_set": bool(os.getenv("LDAP_BIND_PASSWORD")),
    "ldap_user_attribute": os.getenv("LDAP_USER_ATTRIBUTE", "sAMAccountName"),
    "ldap_mail_attribute": os.getenv("LDAP_MAIL_ATTRIBUTE", "mail"),
    "ldap_firstname_attribute": os.getenv("LDAP_FIRSTNAME_ATTRIBUTE", "givenName"),
    "ldap_lastname_attribute": os.getenv("LDAP_LASTNAME_ATTRIBUTE", "sn"),
    "ldap_validate_cert": os.getenv("LDAP_VALIDATE_CERT", "false") == "true",
    "url": f"https://{host}/" if host else "",
    "app_up": up,
}
json.dump(config, fp=sys.stdout)
