{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "get-configuration output",
    "$id": "http://schema.nethserver.org/elabftw/get-configuration-output.json",
    "description": "Get eLabFTW configuration",
    "type": "object",
    "properties": {
        "host": { "type": "string" },
        "http2https": { "type": "boolean" },
        "lets_encrypt": { "type": "boolean" },
        "timezone": { "type": "string" },
        "max_upload_mb": { "type": "integer" },
        "ldap_enabled": { "type": "boolean" },
        "ldap_mail_attribute": { "type": "string" },
        "ldap_firstname_attribute": { "type": "string" },
        "ldap_lastname_attribute": { "type": "string" },
        "ldap_source": { "type": "string" },
        "ldap_domain": { "type": "string" },
        "ldap_group": { "type": "string" },
        "ldap_url": { "type": "string" },
        "ldap_start_tls": { "type": "boolean" },
        "ldap_tls_verify": { "type": "boolean" },
        "ldap_schema": { "type": "string" },
        "ldap_base_dn": { "type": "string" },
        "ldap_bind_dn": { "type": "string" },
        "ldap_user_attribute": { "type": "string" },
        "ldap_bind_password_set": { "type": "boolean" },
        "user_domains": { "type": "array", "items": { "type": "string" } },
        "url": { "type": "string" },
        "app_up": { "type": "boolean" }
    }
}
