{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "get-configuration output",
    "$id": "http://schema.nethserver.org/elabftw/get-configuration-output.json",
    "description": "Get eLabFTW configuration",
    "type": "object",
    "properties": {
        "host": {
            "type": "string"
        },
        "http2https": {
            "type": "boolean"
        },
        "lets_encrypt": {
            "type": "boolean"
        },
        "timezone": {
            "type": "string"
        },
        "max_upload_mb": {
            "type": "integer"
        },
        "ldap_enabled": {
            "type": "boolean"
        },
        "ldap_url": {
            "type": "string"
        },
        "ldap_base_dn": {
            "type": "string"
        },
        "ldap_bind_dn": {
            "type": "string"
        },
        "ldap_bind_password_set": {
            "type": "boolean"
        },
        "ldap_user_attribute": {
            "type": "string"
        },
        "ldap_mail_attribute": {
            "type": "string"
        },
        "ldap_firstname_attribute": {
            "type": "string"
        },
        "ldap_lastname_attribute": {
            "type": "string"
        },
        "url": {
            "type": "string"
        },
        "app_up": {
            "type": "boolean"
        },
        "ldap_validate_cert": {
            "type": "boolean"
        }
    }
}
