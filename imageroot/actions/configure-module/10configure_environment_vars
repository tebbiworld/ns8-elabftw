# Persist the settings and write state/elabftw.env, the --env-file of the
# application container (variables understood by the elabimg entrypoint).
#
# The directory login is the shared chooser "user domain of this cluster" OR
# "LDAP server of its own" (pypkg/ldapsettings.py, identical to ns8-clamav /
# ns8-openwebui / ns8-arsnova) plus the module glue in pypkg/elabftwldap.py.
# eLabFTW keeps the LDAP connection in its OWN database, so those settings are
# NOT written here: 85configure_ldap / bin/apply-ldap patch eLabFTW's config
# once the application is healthy. This step only persists the module settings,
# the mail/name attributes eLabFTW needs, the ldap.conf certificate policy and
# the pasta loopback mapping a user domain requires.

import json
import os
import sys

import agent
import elabftwldap
import ldapsettings
import modsecrets

data = json.load(sys.stdin)

# --- Traefik transport / application settings --------------------------------
host = data["host"]
h2hs = data.get("http2https", True)
agent.set_env("TRAEFIK_HOST", host)
agent.set_env("TRAEFIK_HTTP2HTTPS", h2hs)
if "lets_encrypt" in data:
    # kept so restore-module can re-create the route with the same setting
    agent.set_env("TRAEFIK_LETS_ENCRYPT", data["lets_encrypt"])
timezone = data.get("timezone") or "UTC"
max_upload = int(data.get("max_upload_mb") or 100)
agent.set_env("TZ", timezone)
agent.set_env("MAX_UPLOAD_MB", str(max_upload))

# --- Directory login (shared building block) ---------------------------------
# domain = a user domain of this cluster (ldapproxy, no credentials stored)
# custom = an LDAP server of its own (URL/bind DN in the environment, bind
#          password in state/passwords.env). eLabFTW supports StartTLS.
ldap_enabled = bool(data.get("ldap_enabled", False))
agent.set_env("LDAP_ENABLED", "true" if ldap_enabled else "false")
ldapsettings.apply(data, active=ldap_enabled, legacy_source="custom")

# eLabFTW needs the attributes for mail (it refuses users without one) and the
# display name; these are not part of the shared settings.
agent.set_env("LDAP_MAIL_ATTRIBUTE", (data.get("ldap_mail_attribute") or "mail").strip() or "mail")
agent.set_env("LDAP_FIRSTNAME_ATTRIBUTE", (data.get("ldap_firstname_attribute") or "givenName").strip() or "givenName")
agent.set_env("LDAP_LASTNAME_ATTRIBUTE", (data.get("ldap_lastname_attribute") or "sn").strip() or "sn")

# OpenLDAP client config mounted read-only over /etc/openldap/ldap.conf in the
# app container (the image's LDAP_TLS_REQCERT hook cannot edit that root-owned
# file when running unprivileged). Self-signed certificates need "never".
with open("ldap.conf.tmp", "w") as fp:
    fp.write("# Generated by configure-module. Do not edit by hand.\n")
    fp.write("TLS_REQCERT %s\n" % elabftwldap.tls_reqcert())
os.replace("ldap.conf.tmp", "ldap.conf")

# A user domain login lets the app container reach the node's ldapproxy on the
# node loopback through pasta --map-host-loopback (see pypkg/elabftwldap.py).
# A changed mapping needs a fresh rootless network: 80start_services stops every
# container first when this marker is present.
if elabftwldap.configure_host_loopback():
    open(".netns-restart", "w").close()

# --- Container env file (--env-file) -----------------------------------------
lines = [
    "# Generated by configure-module. Do not edit by hand.",
    "DB_HOST=127.0.0.1",
    "DB_PORT=3306",
    "DB_NAME=elabftw",
    "DB_USER=elabftw",
    f"DB_PASSWORD={modsecrets.get('MYSQL_PASSWORD')}",
    f"SECRET_KEY={modsecrets.get('SECRET_KEY')}",
    f"SITE_URL=https://{host}",
    # Traefik terminates TLS; the container serves plain HTTP on 8080
    "DISABLE_HTTPS=true",
    # trust X-Forwarded-For from the reverse proxy (same network namespace)
    "SET_REAL_IP=true",
    "SET_REAL_IP_FROM=127.0.0.1",
    f"PHP_TIMEZONE={timezone}",
    f"TZ={timezone}",
    f"MAX_UPLOAD_SIZE={max_upload}M",
    # install the schema on first start, migrate on upgrades
    "AUTO_DB_INIT=true",
    "AUTO_DB_UPDATE=true",
]
# elabftw.env carries the DB password and SECRET_KEY: keep it private
os.umask(0o077)
with open("elabftw.env.tmp", "w") as fp:
    fp.write("\n".join(lines) + "\n")
os.replace("elabftw.env.tmp", "elabftw.env")
