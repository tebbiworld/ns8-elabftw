# Persist the settings and write state/elabftw.env, the --env-file of the
# application container (variables understood by the elabimg entrypoint).
# LDAP settings are stored in eLabFTW's own database by 85configure_ldap.

import json
import os
import subprocess
import sys
import urllib.parse

import agent
import modsecrets

data = json.load(sys.stdin)

host = data["host"]
h2hs = data.get("http2https", True)
agent.set_env("TRAEFIK_HOST", host)
agent.set_env("TRAEFIK_HTTP2HTTPS", h2hs)
if "lets_encrypt" in data:
    # kept so restore-module can re-create the route with the same setting
    agent.set_env("TRAEFIK_LETS_ENCRYPT", data["lets_encrypt"])
timezone = data.get("timezone") or "UTC"
max_upload = int(data.get("max_upload_mb") or 100)
agent.set_env("TZ", timezone)
agent.set_env("MAX_UPLOAD_MB", str(max_upload))

# --- LDAP / Active Directory (persisted for get-configuration / 85configure_ldap)
ldap_enabled = bool(data.get("ldap_enabled", False))
ldap_url = (data.get("ldap_url") or "").strip().rstrip("/")
ldap_host, ldap_port, ldap_scheme = "", "636", "ldaps"
if ldap_url:
    parts = urllib.parse.urlsplit(ldap_url)
    ldap_host = parts.hostname or ""
    ldap_scheme = "ldap" if parts.scheme == "ldap" else "ldaps"
    ldap_port = str(parts.port or (389 if ldap_scheme == "ldap" else 636))
agent.set_env("LDAP_ENABLED", ldap_enabled)
agent.set_env("LDAP_URL", ldap_url)
agent.set_env("LDAP_HOST", ldap_host)
agent.set_env("LDAP_PORT", ldap_port)
agent.set_env("LDAP_SCHEME", ldap_scheme)
agent.set_env("LDAP_BASE_DN", (data.get("ldap_base_dn") or "").strip())
agent.set_env("LDAP_BIND_DN", (data.get("ldap_bind_dn") or "").strip())
if data.get("ldap_bind_password"):
    # a secret: state/passwords.env, not the module environment
    modsecrets.write({"LDAP_BIND_PASSWORD": data["ldap_bind_password"]})
agent.set_env("LDAP_USER_ATTRIBUTE", (data.get("ldap_user_attribute") or "sAMAccountName").strip())
agent.set_env("LDAP_MAIL_ATTRIBUTE", (data.get("ldap_mail_attribute") or "mail").strip())
agent.set_env("LDAP_FIRSTNAME_ATTRIBUTE", (data.get("ldap_firstname_attribute") or "givenName").strip())
agent.set_env("LDAP_LASTNAME_ATTRIBUTE", (data.get("ldap_lastname_attribute") or "sn").strip())
ldap_validate_cert = bool(data.get("ldap_validate_cert", False))
agent.set_env("LDAP_VALIDATE_CERT", "true" if ldap_validate_cert else "false")

# OpenLDAP client config mounted read-only over /etc/openldap/ldap.conf in the
# app container (the image's LDAP_TLS_REQCERT hook cannot edit that root-owned
# file when running unprivileged). Self-signed AD certificates need "never".
with open("ldap.conf.tmp", "w") as fp:
    fp.write("# Generated by configure-module. Do not edit by hand.\n")
    fp.write("TLS_REQCERT %s\n" % ("demand" if ldap_validate_cert else "never"))
os.replace("ldap.conf.tmp", "ldap.conf")

# the app container cannot reach its own node's IP: substitute the host name
# when the directory server is this node (see bin/ldap-container-host)
container_ldap_host = ldap_host
if ldap_host:
    container_ldap_host = subprocess.run(
        [os.path.expanduser("~/.config/bin/ldap-container-host"), ldap_host],
        capture_output=True, text=True, check=True,
    ).stdout.strip() or ldap_host
agent.set_env("LDAP_CONTAINER_HOST", container_ldap_host)

lines = [
    "# Generated by configure-module. Do not edit by hand.",
    "DB_HOST=127.0.0.1",
    "DB_PORT=3306",
    "DB_NAME=elabftw",
    "DB_USER=elabftw",
    f"DB_PASSWORD={modsecrets.get('MYSQL_PASSWORD')}",
    f"SECRET_KEY={modsecrets.get('SECRET_KEY')}",
    f"SITE_URL=https://{host}",
    # Traefik terminates TLS; the container serves plain HTTP on 8080
    "DISABLE_HTTPS=true",
    # trust X-Forwarded-For from the reverse proxy (same network namespace)
    "SET_REAL_IP=true",
    "SET_REAL_IP_FROM=127.0.0.1",
    f"PHP_TIMEZONE={timezone}",
    f"TZ={timezone}",
    f"MAX_UPLOAD_SIZE={max_upload}M",
    # install the schema on first start, migrate on upgrades
    "AUTO_DB_INIT=true",
    "AUTO_DB_UPDATE=true",
]
# elabftw.env carries the DB password and SECRET_KEY: keep it private
os.umask(0o077)
with open("elabftw.env.tmp", "w") as fp:
    fp.write("\n".join(lines) + "\n")
os.replace("elabftw.env.tmp", "elabftw.env")
