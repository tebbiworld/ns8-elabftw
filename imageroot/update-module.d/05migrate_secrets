# Up to 1.0.0 the secrets were stored with agent.set_env(), i.e. in
# state/environment, which the agent mirrors to Redis in plain text. Move them
# to state/passwords.env (0600); the values do not change.

import os

import modsecrets

modsecrets.migrate_from_env(["SECRET_KEY", "MYSQL_ROOT_PASSWORD", "MYSQL_PASSWORD", "LDAP_BIND_PASSWORD"])

# elabftw.env carries the DB password and SECRET_KEY as well
path = os.path.join(os.environ["AGENT_STATE_DIR"], "elabftw.env")
if os.path.exists(path):
    os.chmod(path, 0o600)
