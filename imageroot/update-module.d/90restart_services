# The core's update-module action does not restart the module's units. Restart
# the pod so a new pinned eLabFTW version runs right away; its entrypoint
# migrates the database schema (AUTO_DB_UPDATE).

set -e
exec 1>&2

systemctl --user daemon-reload
systemctl --user try-restart elabftw.service elabftw-db.service elabftw-app.service
